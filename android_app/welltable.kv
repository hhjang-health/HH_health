                padding: dp(24),dp(4),dp(24),dp(12)
                RoundedCard:
                    radius: dp(30)
                    background_color: .047,.071,.118,.48
                    border_color: .95,.97,1,.17
                    padding: dp(20),dp(17)
                    orientation: 'vertical'
                    Label:
                        text: '현재 체중'
                        font_name: app.font_name
                        color: .62,.70,.88,1
                        font_size: dp(11)
                        bold: True
                        halign: 'left'
                        text_size: self.size
                    BoxLayout:
                        Label:
                            id: weight
                            text: '68.4'
                            font_name: app.font_name
                            font_size: dp(42)
                            bold: True
                            color: 1,1,1,1
                            halign: 'left'
                            text_size: self.size
                        Label:
                            id: weight_unit
                            text: 'kg'
                            font_name: app.font_name
                            font_size: dp(15)
                            color: .60,.67,.79,1
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size
                    Label:
                        text: '꾸준한 기록이 나만의 기준을 만들어요'
                        font_name: app.font_name
                        font_size: dp(11)
                        color: .59,.66,.77,1
                        halign: 'left'
                        text_size: self.size
            BoxLayout:
                size_hint_y: None
                height: dp(102)
                padding: dp(24),dp(8),dp(24),dp(8)
                spacing: dp(10)
                RoundedCard:
                    background_color: .045,.067,.112,.42
                    border_color: .95,.97,1,.16
                    padding: dp(14),dp(12)
                    orientation: 'vertical'
                    Label:
                        text: '체지방률'
                        font_name: app.font_name
                        color: .60,.66,.77,1
                        font_size: dp(10)
                        halign: 'left'
                        text_size: self.size
                    Label:
                        id: fat
                        text: '—'
                        font_name: app.font_name
                        color: .98,.98,1,1
                        font_size: dp(20)
                        bold: True
                        halign: 'left'
                        shorten: True
                        text_size: self.size
                RoundedCard:
                    background_color: .045,.067,.112,.42
                    border_color: .95,.97,1,.16
                    padding: dp(14),dp(12)
                    orientation: 'vertical'
                    Label:
                        text: '골격근량'
                        font_name: app.font_name
                        color: .60,.66,.77,1
                        font_size: dp(10)
                        halign: 'left'
                        text_size: self.size
                    Label:
                        id: muscle
                        text: '—'
                        font_name: app.font_name
                        color: .98,.98,1,1
                        font_size: dp(20)
                        bold: True
                        halign: 'left'
                        shorten: True
                        text_size: self.size
            BoxLayout:
                size_hint_y: None
                height: dp(102)
                padding: dp(24),dp(2),dp(24),dp(10)
                spacing: dp(10)
                RoundedCard:
                    background_color: .045,.067,.112,.42
                    border_color: .95,.97,1,.16
                    padding: dp(14),dp(12)
                    orientation: 'vertical'
                    Label:
                        text: '최근 심박수'
                        font_name: app.font_name
                        color: .60,.66,.77,1
                        font_size: dp(10)
                        halign: 'left'
                        text_size: self.size
                    Label:
                        id: heart_rate
                        text: '—'
                        font_name: app.font_name
                        color: .98,.98,1,1
                        font_size: dp(19)
                        bold: True
                        halign: 'left'
                        shorten: True
                        text_size: self.size
                RoundedCard:
                    background_color: .045,.067,.112,.42
                    border_color: .95,.97,1,.16
                    padding: dp(14),dp(12)
                    orientation: 'vertical'
                    Label:
                        text: '최근 수면'
                        font_name: app.font_name
                        color: .60,.66,.77,1
                        font_size: dp(10)
                        halign: 'left'
                        text_size: self.size
                    Label:
                        id: sleep_hours
                        text: '—'
                        font_name: app.font_name
                        color: .98,.98,1,1
                        font_size: dp(19)
                        bold: True
                        halign: 'left'
                        shorten: True
                        text_size: self.size
            BoxLayout:
                size_hint_y: None
                height: dp(76)
                padding: dp(24),dp(2),dp(24),dp(8)
                RoundedCard:
                    background_color: .040,.105,.108,.46
                    border_color: .56,.92,.78,.24
                    padding: dp(14),dp(10)
                    BoxLayout:
                        orientation: 'vertical'
                        Label:
                            text: '내 식당'
                            font_name: app.font_name
                            font_size: dp(11)
                            bold: True
                            color: .66,.96,.83,1
                            halign: 'left'
                            text_size: self.size
                        Label:
                            id: cafeteria_summary
                            text: '설정한 식당이 없어요'
                            font_name: app.font_name
                            font_size: dp(10)
                            color: .66,.76,.78,1
                            halign: 'left'
                            shorten: True
                            text_size: self.size
                    GlassButton:
                        text: '식당 설정'
                        size_hint_x: None
                        width: dp(74)
                        font_size: dp(9)
                        glass_color: .08,.34,.27,.54
                        color: .72,1,.86,1
                        on_release: app.popup_cafeterias()
            Label:
                text: '건강 기록 히스토리'
                font_name: app.font_name
                size_hint_y: None
                height: dp(42)
                padding_x: dp(24)
                font_size: dp(18)
                bold: True
                color: .98,.98,1,1
                halign: 'left'
                valign: 'middle'
                text_size: self.size
            ScrollView:
                id: body_scroll
                do_scroll_x: False
                bar_width: 0
                effect_cls: ScrollEffect
                scroll_distance: dp(6)
                scroll_timeout: 60
                BoxLayout:
                    id: body_box
                    orientation: 'vertical'
                    spacing: dp(9)
                    padding: dp(24),dp(0),dp(24),dp(20)
                    size_hint_x: None
                    width: root.width
                    size_hint_y: None
                    height: self.minimum_height
            Label:
                id: version_label
                text: ''
                font_name: app.font_name
                font_size: dp(10)
                color: .45,.52,.64,1
                size_hint_y: None
                height: dp(24)
                halign: 'center'
        TopScrollMask:
            pos: root.x, root.top - self.height
        AppDock:
            size_hint: None, None
            size: root.width - dp(40), dp(54)
            pos: root.x + dp(20), root.y + dp(10)
            selected: 'body'

ScreenManager:
    transition: NoTransition()
    HomeScreen:
        name: 'home'
    MealsScreen:
        name: 'meals'
    WorkoutScreen:
        name: 'workouts'
    ReportScreen:
        name: 'report'
    BodyScreen:
        name: 'body'
